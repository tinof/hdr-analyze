#!/usr/bin/env bash
# Fake Antigravity CLI for pre-pr-gemini-test.sh. Behaves like agy 1.3.1 in print mode with
# --input-format/--output-format stream-json, in the event shapes recorded on 2026-10-07/08.
#
# FAKE_DIR: state dir (attempt counter, per-attempt args and stdin).
# FAKE_AGY_PLAN: comma-separated scenario per attempt (the last one repeats).
# FAKE_AGY_HOME: where to write conversations/<id>.db-wal for the heartbeat scenario.
set -u
n=$(( $(command cat "$FAKE_DIR/count" 2> /dev/null || echo 0) + 1 ))
echo "$n" > "$FAKE_DIR/count"
printf '%s\n' "$@" > "$FAKE_DIR/a$n.args"
command cat > "$FAKE_DIR/a$n.stdin"
echo "$PRE_PR_GEMINI_ATTEMPT" > "$FAKE_DIR/a$n.marker"
IFS=, read -r -a plan <<< "${FAKE_AGY_PLAN:-ok}"
idx=$(( n <= ${#plan[@]} ? n - 1 : ${#plan[@]} - 1 ))
scenario=${plan[$idx]}

log=/dev/null
while [ "$#" -gt 0 ]; do
    [ "$1" = --log-file ] && log=$2
    shift
done
nonce=$(grep -o 'REVIEW-NONCE: [0-9a-f]\{24\}' "$FAKE_DIR/a$n.stdin" | cut -d' ' -f2)
conv="fake-conv-$n"

init() { echo "{\"event\":\"init\",\"conversation_id\":\"$conv\",\"init\":{\"model\":\"fake\",\"tools\":[\"view_file\"]}}"; }
step() { echo "{\"event\":\"step_update\",\"step_update\":{\"conversation_id\":\"$conv\",$1}}"; }
reads() {
    step '"step_index":0,"state":"DONE","step_type":"user_input"'
    step '"step_index":1,"state":"DONE","step_type":"agent_response","duration_seconds":1,"usage":{"input_tokens":100,"output_tokens":20,"thinking_tokens":15}'
    step '"step_index":2,"state":"ACTIVE","step_type":"tool","tool_name":"view_file","tool_info":{"name":"view_file","parameters":{"AbsolutePath":"/repo/CLAUDE.md"}}'
    step '"step_index":2,"state":"DONE","step_type":"tool","tool_name":"view_file","tool_info":{"name":"view_file","parameters":{"AbsolutePath":"/repo/CLAUDE.md"},"output":"1 lines"}'
}
# A finish step opens as a tool and closes as finish.
finish_steps() {
    step '"step_index":3,"state":"DONE","step_type":"agent_response","duration_seconds":2,"usage":{"input_tokens":50,"output_tokens":40,"thinking_tokens":30}'
    step '"step_index":4,"state":"ACTIVE","step_type":"tool","tool_name":"finish","tool_info":{"name":"finish","parameters":{"nonce":"x"}}'
    step '"step_index":4,"state":"DONE","step_type":"finish"'
}
result() { # $1 = status, $2 = structured_output JSON, $3 = extra fields
    echo "{\"event\":\"result\",\"result\":{\"conversation_id\":\"$conv\",\"status\":\"$1\",\"response\":\"\",\"num_turns\":1,\"structured_output\":$2${3:+,$3},\"usage\":{\"input_tokens\":150,\"output_tokens\":60,\"thinking_tokens\":45,\"cache_read_tokens\":0,\"total_tokens\":210}}}"
}
good() { result SUCCESS "{\"nonce\":\"$nonce\",\"findings\":[{\"priority\":\"P2\",\"file\":\"a.rs\",\"line\":3,\"summary\":\"s\",\"scenario\":\"x\"}]}"; }
escaped_child() { setsid sleep 300 < /dev/null > /dev/null 2>&1 & }

case $scenario in
    ok) init; reads; finish_steps; good ;;
    thinkwal) # silent stream for 5 s while the conversation store is written every second
        init; reads
        mkdir -p "$FAKE_AGY_HOME/conversations"
        for _ in 1 2 3 4 5; do sleep 1; date >> "$FAKE_AGY_HOME/conversations/$conv.db-wal"; done
        finish_steps; good ;;
    hang) init; reads; sleep 300 ;;
    hangterm) init; reads; trap '' TERM; while :; do sleep 1; done ;;
    hangescape) init; reads; escaped_child; sleep 300 ;;
    escape) init; reads; escaped_child; finish_steps; good ;;
    forkterm) # a session-escaped child that forks a new one when it gets TERM
        init; reads
        setsid bash -c 'trap "setsid sleep 300 < /dev/null > /dev/null 2>&1 & exit 0" TERM; while :; do sleep 1; done' \
            < /dev/null > /dev/null 2>&1 &
        finish_steps; good ;;
    deny)
        init; reads
        step '"step_index":3,"state":"DONE","step_type":"agent_response","duration_seconds":1,"usage":{"input_tokens":70,"output_tokens":10,"thinking_tokens":5}'
        step '"step_index":4,"state":"ACTIVE","step_type":"tool","tool_name":"view_file","tool_info":{"name":"view_file","parameters":{"AbsolutePath":"/home/someone/.claude/skills/x/watch.sh"}}'
        echo 'I1007 23:57:23.627869     452 tool_confirmation_manager.go:212] Print mode: soft-denying tool confirmation "ViewFile" at step 4' >> "$log"
        echo 'the view_file tool(s) required approval that headless mode cannot prompt for, so they were auto-denied.' >&2
        result SUCCESS null '"denied_actions":[{"action":"read_file","display_name":"Read watch.sh"}]' ;;
    denycmd)
        init; reads
        step '"step_index":3,"state":"ACTIVE","step_type":"tool","tool_name":"run_command","tool_info":{"name":"run_command","parameters":{"CommandLine":"git log"}}'
        echo 'Print mode: soft-denying tool confirmation "RunCommand" at step 3' >> "$log"
        result SUCCESS null '"denied_actions":[{"action":"run_command","display_name":"Run git log"}]' ;;
    noresult) init; reads; echo 'AGY_ERROR: {"canonical_status":"UNAVAILABLE","code":503,"retryable":true,"error_id":"e1"}' >&2; exit 3 ;;
    noresult0) init; reads; printf '{"event":"step_update","step_upd' ;;
    malformed) init; reads; finish_steps; result SUCCESS "{\"nonce\":\"$nonce\",\"findings\":\"none\"}" ;;
    badnonce) init; reads; finish_steps; result SUCCESS '{"nonce":"0000","findings":[]}' ;;
    cancelled) init; reads; result CANCELLED null ;;
    weirdrc) init; reads; exit 7 ;;
    fatal) init; reads
        echo 'AGY_ERROR: {"canonical_status":"RESOURCE_EXHAUSTED","code":429,"retryable":false,"error_id":"e2"}' >&2
        result ERROR null '"error":"quota exhausted"'; exit 3 ;;
    fatal3) init; reads; echo 'AGY_ERROR: {"canonical_status":"UNAUTHENTICATED","code":401,"retryable":false}' >&2; exit 3 ;;
    startup)
        echo 'error: invalid model selection (--model "x"): model x is not recognized' >&2
        echo '{"event":"result","result":{"conversation_id":"","status":"ERROR","response":"","error":"invalid model selection","duration_seconds":0,"num_turns":0,"usage":{"input_tokens":0,"output_tokens":0,"thinking_tokens":0,"cache_read_tokens":0,"total_tokens":0}}}'
        exit 1 ;;
    *) echo "fake-agy: unknown scenario $scenario" >&2; exit 99 ;;
esac
exit 0
